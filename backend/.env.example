# Scaffold backend configuration.
#
# Copy to .env.local (gitignored) and adjust. For Docker (`./run-backend`),
# .env.local is loaded into the backend container. For `go run ./cmd/api`,
# source it first:  set -a && . ./.env.local && set +a && go run ./cmd/api

# ── Server ──────────────────────────────────────────────────────────────────
ADDR=:8080
# Public base URL the server builds magic-link verify URLs from.
BASE_URL=http://localhost:8080

# ── Instance ──────────────────────────────────────────────────────────────────
# "selfhost" (HS256 JWT, magic-link auth) or "hosted" (RS256 JWT).
INSTANCE_MODE=selfhost
# DEV_MODE=true relaxes the email-provider requirement and returns the
# magic-link token inline in the API response so you can sign in without an
# inbox. Must be false in hosted mode.
DEV_MODE=true
# Optional comma-separated allowlist of addresses that receive their magic-link
# token inline even when DEV_MODE is off (for app-store reviewers).
# DEMO_LOGIN_EMAILS=appstore-review@scaffold.app,playstore-review@scaffold.app

# ── Database ──────────────────────────────────────────────────────────────────
# `./run-backend` runs Postgres on host port 5433.
DATABASE_URL=postgres://scaffold:scaffold@localhost:5433/scaffold?sslmode=disable
# Password for the `postgres` service in docker-compose.yml (self-contained
# deploy). Not read by the Go binary itself — only consumed by Compose.
POSTGRES_PASSWORD=dev-only-change-me
# Host path Postgres data is bind-mounted from. Defaults to ./.pgdata
# (gitignored) if unset. On the Proxmox deploy target, point this at the ZFS
# dataset instead, e.g. /tank/apps/strong-notes/pgdata.
# POSTGRES_DATA_DIR=/tank/apps/strong-notes/pgdata

# ── JWT ─────────────────────────────────────────────────────────────────────
# selfhost: HS256 shared secret, MUST be at least 32 characters.
JWT_SECRET=dev-only-change-me-32-chars-minimum!!
# hosted: RS256 PEM keypair instead of JWT_SECRET.
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=
# How long a magic-link token is valid. Default 15m.
# MAGIC_LINK_TTL=15m

# ── Email ─────────────────────────────────────────────────────────────────────
# In DEV_MODE the token is returned inline, so email is optional. For real
# delivery configure SMTP (RESEND_API_KEY is reserved for a future transport).
# RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=noreply@scaffold.app

# ── Storage (S3-compatible) ──────────────────────────────────────────────────
# Disabled for this project — leave S3_ENDPOINT empty. Avatar uploads and any
# other S3-backed feature are out of scope; docker-compose.yml no longer runs
# a MinIO service. Fill these in only if you point S3_ENDPOINT at a real
# provider yourself.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ── Background jobs (River) ──────────────────────────────────────────────────
# When true, the magic-link email is sent by a River background worker instead
# of inline on the request path. Requires the River migrations (included).
JOBS_ENABLED=false

# ── Sign in with Apple ───────────────────────────────────────────────────────
# iOS bundle identifier, used as the expected audience when verifying Apple
# identity tokens on POST /api/auth/apple/native. Empty = route disabled.
# APPLE_BUNDLE_ID=com.dowlucas.strongnotes

# ── Protocol bounds ──────────────────────────────────────────────────────────
# Accepted X-Scaffold-App-Protocol header range on authenticated requests.
MIN_APP_PROTOCOL=0
MAX_APP_PROTOCOL=1

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Comma-separated CIDRs/IPs of trusted proxies whose X-Forwarded-For / X-Real-IP
# headers are honored. Empty = ignore forwarded headers (safe default).
# TRUSTED_PROXIES=127.0.0.1/32

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to the Expo dev web ports
# (http://localhost:8081, http://localhost:19006) when unset.
# ALLOWED_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── LLM (shorthand/goal resolution fallback) ────────────────────────────────
# "ollama" (local, default), "anthropic", or "gemini".
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
# Required only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required only when LLM_PROVIDER=gemini. Uses Google's Generative Language API
# (generateContent REST endpoint). GEMINI_MODEL defaults to gemini-3.1-flash-lite.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Set this to your own email in your local .env.local (not committed) so LLM
# exercise-confirm test flows can sign you in without inbox access; leave
# blank here (DEV_MODE=true above already returns magic-link tokens inline).
DEMO_LOGIN_EMAILS=
